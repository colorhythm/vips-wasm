{
  "name": "@colorhythm/vips-wasm",
  "version": "0.0.19-colorhythm.1",
  "description": "Colorhythm distribution of libvips for the browser and Node.js, compiled to WebAssembly with Emscripten",
  "homepage": "https://github.com/colorhythm/vips-wasm#readme",
  "bugs": {
    "url": "https://github.com/colorhythm/vips-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colorhythm/vips-wasm.git"
  },
  "license": "MIT",
  "author": "Kleis Auke Wolthuizen",
  "type": "commonjs",
  "exports": {
    ".": {
      "browser": {
        "import": "./lib/vips-es6.js",
        "require": "./lib/vips.js"
      },
      "node": {
        "import": "./lib/vips-node.mjs",
        "require": "./lib/vips-node.js"
      },
      "default": "./lib/vips.js"
    },
    "./versions": "./versions.json",
    "./vips.wasm": "./lib/vips.wasm",
    "./vips-heif.wasm": "./lib/vips-heif.wasm",
    "./vips-jxl.wasm": "./lib/vips-jxl.wasm",
    "./vips-resvg.wasm": "./lib/vips-resvg.wasm",
    "./integrity": "./integrity.json"
  },
  "main": "lib/vips-node.js",
  "browser": "lib/vips.js",
  "types": "lib/vips.d.ts",
  "files": [
    "integrity.json",
    "lib/*.js",
    "lib/*.mjs",
    "lib/vips.d.ts",
    "lib/vips.wasm",
    "lib/vips-heif.wasm",
    "lib/vips-jxl.wasm",
    "lib/vips-resvg.wasm",
    "THIRD-PARTY-NOTICES.md",
    "versions.json"
  ],
  "scripts": {
    "bench": "npm run bench:node",
    "bench:node": "npm --prefix test/bench test",
    "bench:web": "serve -c test/bench/serve.json",
    "build": "docker build -t wasm-vips . && docker run -it --rm -v $(pwd):/src wasm-vips ./build.sh",
    "release:prepare": "node tools/prepare-release.mjs",
    "release:verify": "node tools/verify-release.mjs",
    "test": "npm run test:lint && npm run test:release && npm run test:dynamic-code && npm run test:node",
    "test:dynamic-code": "node tools/check-dynamic-code.mjs",
    "test:lint": "biome lint",
    "test:node": "npm --prefix test/unit test",
    "test:release": "node tools/release-integrity.selftest.mjs",
    "test:web": "serve -c test/unit/serve.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": ">=17.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
