diff --git a/system/include/emscripten/bind.h b/system/include/emscripten/bind.h
index e542668c606a0..2219ee49ae93e 100644
--- a/system/include/emscripten/bind.h
+++ b/system/include/emscripten/bind.h
@@ -88,6 +88,13 @@ void _embind_register_std_wstring(
     size_t charSize,
     const char* name);
 
+void _embind_register_arithmetic_vector(
+    TYPEID vectorType,
+    const char *name,
+    size_t elementSize,
+    bool isFloat,
+    bool isSigned);
+
 void _embind_register_emval(
     TYPEID emvalType);
 
@@ -1912,7 +1919,8 @@ struct VectorAccess {
 } // end namespace internal
 
 template<typename T, class Allocator=std::allocator<T>>
-class_<std::vector<T, Allocator>> register_vector(const char* name) {
+typename std::enable_if<!std::is_arithmetic<T>::value, class_<std::vector<T, Allocator>>>::type
+register_vector(const char* name) {
     typedef std::vector<T, Allocator> VecType;
     register_optional<T>();
     using VectorElementType =
@@ -1928,6 +1936,17 @@ class_<std::vector<T, Allocator>> register_vector(const char* name) {
         .template iterable<VectorElementType>("size", "get");
 }
 
+template<typename T>
+typename std::enable_if<std::is_arithmetic<T>::value, void>::type
+register_vector(const char* name) {
+    internal::_embind_register_arithmetic_vector(
+        internal::TypeID<std::vector<T>>::get(),
+        name,
+        sizeof(T),
+        std::is_floating_point<T>::value,
+        std::is_signed<T>::value);
+}
+
 ////////////////////////////////////////////////////////////////////////////////
 // MAPS
 ////////////////////////////////////////////////////////////////////////////////
diff --git a/system/include/emscripten/wire.h b/system/include/emscripten/wire.h
index 18aec9c4408e5..5724505c7445d 100644
--- a/system/include/emscripten/wire.h
+++ b/system/include/emscripten/wire.h
@@ -22,6 +22,7 @@
 #include <cstdlib>
 #include <memory>
 #include <string>
+#include <vector>
 
 #define EMSCRIPTEN_ALWAYS_INLINE __attribute__((always_inline))
 #define EMBIND_VISIBILITY_DEFAULT __attribute__((visibility("default")))
@@ -326,17 +327,21 @@ struct BindingType<bool> {
 };
 
 template<typename T>
-struct BindingType<std::basic_string<T>> {
+    struct BindingType<std::basic_string<T>,
+    typename std::enable_if<std::is_trivially_copyable<T>::value>::type> {
     using String = std::basic_string<T>;
-    static_assert(std::is_trivially_copyable<T>::value, "basic_string elements are memcpy'd");
-    typedef struct {
+    struct StringStruct {
         size_t length;
         T data[1]; // trailing data
-    }* WireType;
+    };
+    static_assert(offsetof(StringStruct, data) == sizeof(size_t),
+        "Unexpected padding");
+    using WireType = StringStruct *;
+
     static WireType toWireType(const String& v, rvp::default_tag) {
         WireType wt = (WireType)malloc(sizeof(size_t) + v.length() * sizeof(T));
         wt->length = v.length();
-        memcpy(wt->data, v.data(), v.length() * sizeof(T));
+        std::copy(v.begin(), v.end(), wt->data);
         return wt;
     }
     static String fromWireType(WireType v) {
@@ -344,6 +349,29 @@ struct BindingType<std::basic_string<T>> {
     }
 };
 
+template<typename T>
+struct BindingType<std::vector<T>,
+  typename std::enable_if<std::is_arithmetic<T>::value>::type> {
+    using Vector = std::vector<T>;
+    struct VectorStruct {
+        size_t length;
+        T data[1]; // trailing data
+    };
+    static_assert(offsetof(VectorStruct, data) == (sizeof(size_t) > sizeof(T) ? sizeof(size_t) : sizeof(T)),
+        "Unexpected padding");
+    using WireType = VectorStruct *;
+
+    static WireType toWireType(const Vector& v, rvp::default_tag) {
+        WireType wt = (WireType)malloc(offsetof(VectorStruct, data) + v.size() * sizeof(T));
+        wt->length = v.size();
+        std::copy(v.begin(), v.end(), wt->data);
+        return wt;
+    }
+    static Vector fromWireType(WireType v) {
+        return Vector(v->data, v->data + v->length);
+    }
+};
+
 template<typename T>
 struct BindingType<const T> : public BindingType<T> {
 };

